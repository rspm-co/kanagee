# Hostinger Web App runtime settings (enter real values in hPanel).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
APP_ORIGIN=https://yourdomain.com
NODE_ENV=production

# Private dashboard at /admin/ (set real values in Hostinger only).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
ADMIN_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
